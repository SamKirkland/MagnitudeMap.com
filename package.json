{
  "name": "magnitudemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/compress-models.mjs && vite build && node scripts/generate-og.mjs",
    "build:static": "tsc --noEmit && node scripts/compress-models.mjs && vite build",
    "compress-models": "node scripts/compress-models.mjs",
    "preview": "vite preview",
    "generate-og": "node scripts/generate-og.mjs",
    "generate-og:ui": "vite --open og-capture.html",
    "lint": "eslint .",
    "sync-attributions": "node scripts/sync-attributions.mjs"
  },
  "dependencies": {
    "@babylonjs/addons": "^9.20.0",
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/gui": "^9.20.0",
    "@babylonjs/gui-editor": "^9.20.0",
    "@babylonjs/inspector": "^9.20.0",
    "@babylonjs/loaders": "^9.20.0",
    "@babylonjs/materials": "^9.20.0",
    "@babylonjs/serializers": "^9.20.0",
    "@headlessui/react": "^1.7.13",
    "@heroicons/react": "^2.0.16",
    "fuse.js": "^7.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "draco3dgltf": "^1.5.7",
    "eslint": "^8.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.19",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.2.7",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
